# Define token categories
#tokenization.py

KEYWORDS = {"int", "main", "float", "double", "if", "else", "do", "for", "while"}
SINGLE_OPERATORS = {"+", "-", "%", "*", "!", ">", "<", "="}
DOUBLE_OPERATORS = {">=", "<=", "==", "!="}
SPECIAL_CHARACTERS = {"(", ")", "{", "}", "[", "]", ":", ";"}


# Check if character is a letter or underscore
def is_letter(ch):
    return ch.isalpha() or ch == "_"


# Check if character is a digit
def is_digit(ch):
    return ch.isdigit()


# Lexical Analyzer Function
def analyze(code):
    unique_identifiers = set()

    keyword_count = 0
    operator_count = 0
    identifier_count = 0
    special_char_count = 0

    i = 0
    n = len(code)

    while i < n:
        ch = code[i]

        # Ignore whitespace
        if ch.isspace():
            i += 1
            continue

        # Identifier or Keyword
        if is_letter(ch):
            start = i
            while i < n and (is_letter(code[i]) or is_digit(code[i])):
                i += 1

            word = code[start:i]

            if word in KEYWORDS:
                keyword_count += 1
            else:
                if word not in unique_identifiers:
                    unique_identifiers.add(word)
                    identifier_count += 1
            continue

        # Special Characters
        if ch in SPECIAL_CHARACTERS:
            special_char_count += 1
            i += 1
            continue

        # Double Character Operators
        if i + 1 < n and code[i:i+2] in DOUBLE_OPERATORS:
            operator_count += 1
            i += 2
            continue

        # Single Character Operators
        if ch in SINGLE_OPERATORS:
            operator_count += 1
            i += 1
            continue

        # Move ahead if nothing matches
        i += 1

    return keyword_count, identifier_count, operator_count, special_char_count


# Taking multi-line input
print("Enter the C code (type END to stop):")

lines = []
while True:
    line = input()
    if line.strip() == "END":
        break
    lines.append(line)

code = "\n".join(lines)

# Analyze code
keywords, identifiers, operators, special_chars = analyze(code)

# Display result
print("\nLexical Analysis Result:")
print("Number of Keywords:", keywords)
print("Number of Identifiers:", identifiers)
print("Number of Operators:", operators)
print("Number of Special Characters:", special_chars)